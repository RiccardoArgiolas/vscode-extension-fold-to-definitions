{
    "name": "fold-to-definitions",
    "displayName": "Fold to Definitions",
    "description": "Folds C# code to definitions",
    "version": "1.7.8",
    "publisher": "argiolasriccardo90",
    "repository": {
        "type": "git",
        "url": "https://github.com/RiccardoArgiolas/vscode-extension-fold-to-definitions"
    },
    "engines": {
        "vscode": "^1.29.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:fold-to-definitions.foldToDefinitions"
    ],
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "fold-to-definitions.foldToDefinitions",
                "title": "Fold to C# definitions"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Fold to Definitions configuration",
            "properties": {
                "foldToDefinitions.useSymbolsMethod": {
                    "type": "boolean",
                    "default": true,
                    "description": "If true, uses executeDocumentSymbolProvider instead of regExs to find classes/methods/properties and fold them"
                },
                "foldToDefinitions.unfoldFirst": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, executes an unfold recursively command before folding to definitions"
                },
                "foldToDefinitions.foldProperties": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, also fold properties"
                },
                "foldToDefinitions.foldSummaries": {
                    "type": "boolean",
                    "default": false,
                    "description": "If true, also folds summaries, such as method comments with format /// <summary> ... </summary>"
                },
                "foldToDefinitions.retainSelection": {
                    "type": "boolean",
                    "default": true,
                    "description": "If true, the selection at the moment of executing the command is retained"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "npm run compile"
    },
    "devDependencies": {
        "typescript": "4.9.5",
        "@types/vscode": "1.29.0",
        "@types/node": "8.10.66",
        "@types/mocha": "2.2.42"
    }
}